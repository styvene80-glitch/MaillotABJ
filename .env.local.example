# Copiez ce fichier en .env.local et remplissez avec vos vraies clés Stripe.
# Clé secrète (Dashboard Stripe > Développeurs > Clés API) — ne jamais la partager publiquement.
STRIPE_SECRET_KEY=sk_test_...

# Clé publique (facultative pour l'instant, utile si vous ajoutez Stripe.js côté client plus tard)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
